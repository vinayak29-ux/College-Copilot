<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/mono_elevated" />
            <stroke android:width="1dp" android:color="@color/mono_white" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/mono_elevated" />
            <stroke android:width="1dp" android:color="@color/mono_border" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</selector>
